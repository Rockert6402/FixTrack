# Copiar como .env y completar con los valores locales
DB_PASSWORD=
# Llave AES de 32 bytes en Base64; se genera con: openssl rand -base64 32
ENCRYPTION_KEY=
# Llave HMAC del JWT de al menos 32 bytes en Base64; se genera con: openssl rand -base64 32
JWT_SECRET=
# Duración del token de sesión; por defecto 8h
# JWT_EXPIRATION=8h
# Administrador inicial: solo se usa si la base no tiene ningún administrador activo
ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@fixtrack.local
# ADMIN_DOCUMENT_NUMBER=1000000000
